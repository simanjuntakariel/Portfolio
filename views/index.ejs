<style>
/* =========================================================
   PROJECT IMAGE LIGHTBOX
========================================================= */

.project-image-link{
    position:relative;
    display:block;
    cursor:zoom-in;
}

.project-image-link::after{
    content:"\f00e";
    font-family:"Font Awesome 6 Free";
    font-weight:900;
    position:absolute;
    left:50%;
    top:50%;
    width:52px;
    height:52px;
    display:flex;
    align-items:center;
    justify-content:center;
    transform:translate(-50%,-50%) scale(.75);
    opacity:0;
    color:#fff;
    background:rgba(255,47,47,.92);
    border-radius:50%;
    box-shadow:0 12px 30px rgba(0,0,0,.35);
    transition:.25s ease;
    pointer-events:none;
}

.project-image-link:hover::after{
    opacity:1;
    transform:translate(-50%,-50%) scale(1);
}

.project-image-link img{
    cursor:zoom-in;
}

/* Viewer */
.image-lightbox{
    position:fixed;
    inset:0;
    z-index:99999;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:30px;
    background:rgba(0,0,0,.92);
    opacity:0;
    visibility:hidden;
    transition:opacity .25s ease, visibility .25s ease;
}

.image-lightbox.show{
    opacity:1;
    visibility:visible;
}

.image-lightbox-content{
    position:relative;
    max-width:min(1200px,94vw);
    max-height:90vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:12px;
}

.image-lightbox-image{
    display:block;
    max-width:94vw;
    max-height:82vh;
    width:auto;
    height:auto;
    object-fit:contain;
    border-radius:12px;
    box-shadow:0 25px 80px rgba(0,0,0,.65);
    transform:scale(.96);
    transition:transform .25s ease;
}

.image-lightbox.show .image-lightbox-image{
    transform:scale(1);
}

.image-lightbox-title{
    max-width:90vw;
    color:#fff;
    text-align:center;
    font-size:.8rem;
    font-weight:600;
}

.image-lightbox-close{
    position:fixed;
    top:22px;
    right:25px;
    width:46px;
    height:46px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    background:rgba(255,47,47,.9);
    border:0;
    border-radius:50%;
    font-size:1.05rem;
    cursor:pointer;
    z-index:100000;
    transition:.25s ease;
}

.image-lightbox-close:hover{
    transform:scale(1.08);
    background:#df1d1d;
}

@media(max-width:600px){
    .image-lightbox{
        padding:15px;
    }

    .image-lightbox-image{
        max-width:96vw;
        max-height:78vh;
        border-radius:8px;
    }

    .image-lightbox-close{
        top:15px;
        right:15px;
        width:42px;
        height:42px;
    }
}
</style>


